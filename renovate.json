{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":separatePatchReleases",
        ":semanticCommits",
        ":semanticCommitScope({{baseDir}})"
    ],
    "packageRules": [
        {
            "additionalBranchPrefix": "{{packageFileDir}}-",
            "matchPackageNames": ["/.*/"],
            "semanticCommitType": "deps"
        }
    ]
}
